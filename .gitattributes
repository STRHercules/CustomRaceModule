# Auto detect text files and perform LF normalization
* text=auto

# Generated admission definitions and source packages must be byte-identical
# across Windows/Linux checkouts. Frozen vendor evidence keeps its own contract.
src/** text eol=lf
conf/** text eol=lf
data/registry/** text eol=lf
schemas/** text eol=lf
docs/installation/** text eol=lf
LICENSE text eol=lf
